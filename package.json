{
  "name": "personal-panel",
  "productName": "Painel Pessoal",
  "version": "1.0.0",
  "description": "Painel pessoal de organização do dia",
  "author": "oguguca",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"vite\" \"wait-on http://localhost:5173 && node scripts/start-electron.mjs\"",
    "dev:web": "vite",
    "build": "vite build",
    "icon": "node scripts/make-icon.mjs",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.oguguca.painelpessoal",
    "productName": "Painel Pessoal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Painel Pessoal"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
